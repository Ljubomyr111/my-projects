// ============================================================================
//  Робосумо 3 кг — спільні параметри
//  Усі розміри в міліметрах. Прав завжди тут, а не в окремих деталях.
//
//  Позначки:
//    ✅  підтверджено з даташита виробника
//    ❓  VERIFY — виміряй свою деталь штангенциркулем і виправ
// ============================================================================

// --- габарит робота ---------------------------------------------------------
CHASSIS_W       = 200;      // ✅ ліміт класу 200 x 200 мм
CHASSIS_L       = 200;
PLATE_T         = 6;        // товщина друкованого прототипу основи
ALLOY_T         = 4;        // товщина алюмінієвої бойової основи

// --- колеса -----------------------------------------------------------------
WHEEL_D         = 50;
WHEEL_W         = 15;
WHEEL_TRACK     = 150;      // між центрами коліс уздовж осі X
WHEELBASE       = 130;      // між центрами коліс уздовж осі Y

// --- мотор Pololu 37D (✅ усі з pololu.com/product/4745) --------------------
MOTOR_BODY_D    = 37;       // ✅ діаметр корпусу редуктора
MOTOR_SHAFT_D   = 6;        // ✅ D-подібний вал
MOTOR_SHAFT_L   = 16;       // ✅ довжина вала
MOTOR_HEX_PITCH = 15.5;     // ✅ суміжні отвори кріплення, правильний шестикутник
MOTOR_HEX_R     = MOTOR_HEX_PITCH / sqrt(3);   // ≈ 8.949 радіус описаного кола
MOTOR_SCREW_MAX = 3;        // ✅ Pololu: НЕ закручувати глибше 3 мм — дістане шестерні
MOTOR_TOTAL_L   = 57;       // ✅ 37Dx57L

// --- кріплення --------------------------------------------------------------
M3_CLEAR        = 3.4;
M3_TAP          = 2.9;
M2_CLEAR        = 2.2;
HEATSET_M3_D    = 4.0;      // отвір під термозакладну гайку M3
HEATSET_M3_H    = 5.7;

// --- плати (❓ виміряй свої) ------------------------------------------------
NANO_W          = 18;       // ✅ стандарт Arduino Nano
NANO_L          = 45;
NANO_HOLE_DX    = 15.24;    // ✅ 0.6 дюйма
NANO_HOLE_DY    = 43.18;    // ✅ 1.7 дюйма

BTS_W           = 25;       // ❓ VERIFY — плата BTS7960 / IBT-2
BTS_L           = 50;       // ❓ VERIFY
BTS_HOLE_DX     = 15;       // ❓ VERIFY
BTS_HOLE_DY     = 44;       // ❓ VERIFY
BTS_QTY         = 4;

QTR_W           = 12;       // ❓ VERIFY — Pololu QTR-8A
QTR_L           = 75;       // ❓ VERIFY
QTR_HOLE_DX     = 10;       // ❓ VERIFY
QTR_HOLE_DY     = 67;       // ❓ VERIFY

// --- акумулятор (❓ виміряй свій) -------------------------------------------
LIP_W           = 34;       // ❓ VERIFY — 6S 2200 мА·год
LIP_L           = 105;      // ❓ VERIFY
LIP_H           = 26;       // ❓ VERIFY

// --- клин -------------------------------------------------------------------
BLADE_W         = 190;
BLADE_T         = 3;
BLADE_ANGLE     = 12;       // ✅ наш вибір: 8–12° за «Blackbook»
BLADE_SCREWS    = 4;

// --- серво ------------------------------------------------------------------
SERVO_W         = 23;       // SG90
SERVO_L         = 32.5;
SERVO_H         = 29;

// --- магніти -----------------------------------------------------------------
MAG_W           = 20;       // 20 x 20 x 5 мм N52
MAG_D           = 5;

// --- якість друку -----------------------------------------------------------
$fn = 64;                   // гладкість круглих отворів
EPS = 0.01;                 // мікро-перекриття для булевих операцій

// ============================================================================
//  Допоміжні модулі
// ============================================================================

// Отвір під гвинт M3 з фаскою, щоб гвинт сідав рівно
module m3_hole(h = 20, head = true) {
    cylinder(d = M3_CLEAR, h = h + 2*EPS, center = true);
    if (head)
        translate([0, 0, h/2])
            cylinder(d1 = M3_CLEAR, d2 = 6.2, h = 1.6);
}

// Отвір під термозакладну гайку M3 (зверху вниз)
module heatset_hole() {
    cylinder(d = HEATSET_M3_D, h = HEATSET_M3_H, center = false);
    translate([0, 0, HEATSET_M3_H])
        cylinder(d = M3_CLEAR, h = 20);
}

// Шість отворів кріплення мотора 37D на правильному шестикутнику.
// Суміжні отвори рознесені рівно на MOTOR_HEX_PITCH.
module motor_mount_holes(depth = 20) {
    for (a = [0 : 60 : 359])
        rotate([0, 0, a])
            translate([MOTOR_HEX_R, 0, 0])
                cylinder(d = M3_CLEAR, h = depth + 2*EPS, center = true);
}

// Шестикутна кишеня під корпус мотора — щоб мотор сів у площину
module motor_body_pocket(depth = 2) {
    translate([0, 0, -depth/2])
        cylinder(d = MOTOR_BODY_D + 0.4, h = depth + EPS, center = true);
}

// Масив отворів по колу — для маточин і фланців
module bolt_circle(dia, n, hole_d = M3_CLEAR, depth = 20) {
    for (i = [0 : n-1])
        rotate([0, 0, i * 360 / n])
            translate([dia/2, 0, 0])
                cylinder(d = hole_d, h = depth + 2*EPS, center = true);
}

// Плита зі скругленими кутами
module rounded_plate(w, h, t, r = 8) {
    linear_extrude(height = t)
        offset(r = r) offset(delta = -r)
            square([w - 2*r, h - 2*r], center = true);
}

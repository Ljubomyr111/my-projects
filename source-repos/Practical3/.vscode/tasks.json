{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build practical (gcc)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-O0",
                "practical.c",
                "-o",
                "practical.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}

// =============================================================================
//  ШАРНІРНЕ З'ЄДНАННЯ — ДЕТАЛЬ №2 (друга деталь шарніра)
//  Гільза-затискач під трубку Ø16 + вилка шарніра + подвійний хомут (2 × М5)
//  OpenSCAD 2021.01+ (F5/F6). Повністю параметрична, сумісна з FDM.
// -----------------------------------------------------------------------------
//  СИСТЕМА КООРДИНАТ
//    Z — вісь гільзи/трубки: z=0 — вхідний торець (трубка заходить у +Z)
//    X — вісь поворотного болта М8 (шарнір); ширина вилки 28 мм уздовж X
//    Y — поперечна вісь: вушка хомута розташовані зверху (y=+13.15) та
//        знизу (y=-13.15)
//
//  РЕАЛІЗОВАНІ РОЗМІРИ (за ТЗ)
//    канал Ø16.3 × 45 мм, стінка 5 мм (зовнішній Ø26.3),
//    внутрішній упор (бурт) + технологічний отвір виходу повітря,
//    вилка: ширина 28, висота 40, паз 10.6, вісь Ø8.2 (болт М8, уздовж X),
//    хомут: 2 вушка (зверху/знизу), поздовжній розріз 2.5 мм (площина x=0),
//    2 отвори Ø5.3 під М5, шестигранні заглиблення 9.2 мм × 4.5 мм.
//
//  ГОЛОВНЕ ГЕОМЕТРИЧНЕ ОБМЕЖЕННЯ (визначає конструкцію хомута)
//    Отвір під М5 не повинен перетинати канал Ø16.3. Розріз — вертикальна
//    площина x=0 (ділить гільзу вздовж на ліву/праву половини). Болти стяжки
//    йдуть ПЕРПЕНДИКУЛЯРНО розрізу (уздовж X) на вушках зверху/знизу,
//    на відстані y=13.15 від осі: найближча точка отвору —
//    sqrt(13.15² + 22.5²) - 2.65 ≈ 23.4 мм від осі каналу, тобто строго
//    ПОЗА каналом (8.15 мм). Верхня і нижня половини гільзи з'єднані
//    конусом і вилкою вище розрізу — деталь монолітна.
// =============================================================================

/* [Основні розміри — з ТЗ] */
bore_d        = 16.3;   // внутрішній діаметр каналу під трубку Ø16 +0.3
wall          = 5.0;    // товщина стінки гільзи -> зовнішній Ø26.3
tube_seat     = 45.0;   // довжина посадки трубки
stop_h        = 3.0;    // висота внутрішнього упора (бурта)
fork_w        = 28.0;   // зовнішня ширина вилки (уздовж осі шарніра X)
fork_h        = 40.0;   // висота вилки
slot_w        = 10.6;   // центральний паз під вушко деталі №1 (уздовж Y)
hinge_d       = 8.2;    // отвір під поворотну вісь (болт М8)
hinge_z       = 70.0;   // висота осі шарніра
fork_top      = 88.0;   // верхній торець вилки
fork_base     = 48.0;   // низ вилки
saddle_h      = 10.0;   // висота «сідла» — перекриває паз знизу

/* [Хомут] */
slit_w        = 2.5;    // ширина поздовжнього розрізу
ear_r         = 6.4;    // радіус вушка (лапи)
ear_len       = 28.0;   // довжина вушка вздовж X (болта)
ear_y         = 13.15;  // положення вушка по Y (зверху/знизу)
ear_z         = 22.5;   // положення вушка по Z (середина посадки)
bolt_d        = 5.3;    // наскрізний отвір під стяжний болт М5
nut_af        = 9.2;    // гайка М5 «під ключ»
nut_depth     = 4.5;    // глибина шестигранного заглиблення
head_d        = 9.4;    // цековка під головку гвинта М5 (DIN 912)
head_depth    = 6.5;    // глибина цековки

/* [Технологічні отвори] */
vent_axial_d  = 3.0;    // осьовий отвір виходу повітря (крізь бурт)
vent_rad_d    = 4.0;    // радіальний отвір виходу повітря (крізь конус)
vent_rad_z    = 46.5;   // висота радіального отвору

/* [Конічна підсилювальна муфта: гільза -> вилка] */
cone_h        = 30.0;   // висота конуса
cone_r0       = 13.93;  // радіус конуса на z=45
cone_r1       = 15.6;   // радіус конуса на z=75

/* [Якість] */
$fn = 96;


// =============================================================================
//  ГІЛЬЗА: стінка + внутрішній упор + технологічні отвори виходу повітря
// =============================================================================
module sleeve() {
    difference() {
        union() {
            // стінка гільзи Ø26.3 / канал Ø16.3, посадка трубки 45 мм
            cylinder(d = bore_d + 2 * wall, h = tube_seat);
            // внутрішній упор: тонкий бурт, у який упирається торець трубки
            translate([0, 0, tube_seat])
                cylinder(d = bore_d, h = stop_h);
        }
        // канал під трубку: від z=0 до внутрішнього упора z=45
        translate([0, 0, -0.01])
            cylinder(d = bore_d, h = tube_seat + 0.01);
        // технологічний отвір 1: осьовий, крізь бурт — вихід повітря
        translate([0, 0, tube_seat - 0.01])
            cylinder(d = vent_axial_d, h = stop_h + 0.02);
        // технологічний отвір 2: радіальний, крізь стінку — вихід повітря
        translate([0, 0, vent_rad_z])
            rotate([90, 0, 0])
                cylinder(d = vent_rad_d, h = 2 * (cone_r0 + 2), center = true);
    }
}


// =============================================================================
//  ВИЛКА + КОНІЧНА ПІДСИЛЮВАЛЬНА МУФТА
//  Щоки вилки (передня/задня, |y| = 5.3..14) + «сідло», що перекриває паз
//  знизу. Паз 10.6 мм (|y| < 5.3) відкритий зверху. Вісь шарніра Ø8.2 — X.
// =============================================================================
module fork_arm(sy) {
    y_in  = slot_w / 2;   // 5.3
    y_out = fork_w / 2;   // 14.0
    translate([0, sy * (y_in + y_out) / 2, fork_base + fork_h / 2])
        cube([fork_w, y_out - y_in, fork_h], center = true);
}

module fork() {
    difference() {
        union() {
            // конічна підсилювальна муфта: плавний перехід гільза -> вилка
            translate([0, 0, tube_seat])
                cylinder(r1 = cone_r0, r2 = cone_r1, h = cone_h);
            // «сідло»: перекриває паз знизу (z=48..58), з'єднує щоки
            translate([0, 0, fork_base + saddle_h / 2])
                cube([fork_w, slot_w, saddle_h], center = true);
            // дві щоки вилки
            for (sy = [-1, 1]) fork_arm(sy);
        }
        // отвір під поворотну вісь Ø8.2 (болт М8): вісь уздовж X
        translate([0, 0, hinge_z])
            rotate([0, 90, 0])
                cylinder(d = hinge_d, h = fork_w + 2, center = true);
        // центральний паз під вушко деталі №1: ширина рівно 10.6 мм (|y|<5.3),
        // від z=58 (верх сідла) до верхнього торця вилки — прорізає і конус
        translate([0, 0, fork_base + saddle_h + (fork_h - saddle_h) / 2])
            cube([fork_w + 20, slot_w, fork_h - saddle_h + 4], center = true);
    }
}


// =============================================================================
//  ВУШКА ХОМУТА (зверху sy=+1, знизу sy=-1) + стяжні болти М5
//  Вушко — лапа вздовж X (вздовж болта), занурена в стінку гільзи через
//  hull(): переріз монотонно зростає від підошви (у тілі стінки) до
//  повного Ø12.8, тож під вушком немає звисаючих кутів/сходинок.
// =============================================================================
module clamp_ear(sy) {
    hull() {
        // підошва: всередині стінки гільзи
        translate([0, sy * (ear_y - 1.65), ear_z])
            rotate([0, 90, 0])
                cylinder(r = 1.8, h = ear_len, center = true);
        // тіло лапи вушка
        translate([0, sy * ear_y, ear_z])
            rotate([0, 90, 0])
                cylinder(r = ear_r, h = ear_len, center = true);
    }
}

module bolt_features(sy) {
    y = sy * ear_y;
    // наскрізний отвір Ø5.3 (вісь уздовж X, на відстані 13.15 від осі Y)
    translate([0, y, ear_z])
        rotate([0, 90, 0])
            cylinder(d = bolt_d, h = ear_len + 2, center = true);
    // шестигранне заглиблення під гайку М5 (+X торець): 9.2 мм «під ключ»
    translate([ear_len / 2 - nut_depth, y, ear_z])
        rotate([0, 90, 0])
            cylinder(d = nut_af / cos(30), h = nut_depth + 0.5, $fn = 6);
    // цековка під головку гвинта М5 (-X торець)
    translate([-(ear_len / 2 - head_depth), y, ear_z])
        rotate([0, 90, 0])
            cylinder(d = head_d, h = head_depth + 0.5);
}


// =============================================================================
//  СКЛАДАННЯ
// =============================================================================
module hinge_clamp_sleeve() {
    difference() {
        union() {
            sleeve();
            fork();
            clamp_ear(1);
            clamp_ear(-1);
        }
        // поздовжній розріз 2.5 мм: площина x=0, ділить гільзу та обидва
        // вушка вздовж на ліву/праву половини (для можливості стискання)
        translate([-slit_w / 2, -40, -1])
            cube([slit_w, 80, tube_seat + 2]);
        // стяжні болти М5 в обох вушках
        bolt_features(1);
        bolt_features(-1);
    }
}

RENDER_MAIN = true;
if (RENDER_MAIN) hinge_clamp_sleeve();


// =============================================================================
//  КОНТРОЛЬ РОЗМІРІВ (виводиться у консоль F5/F6)
// =============================================================================
echo(str("Гільза: канал Ø", bore_d, " / зовнішній Ø", bore_d + 2 * wall,
         " / посадка ", tube_seat, " мм"));
echo(str("Вилка: ширина ", fork_w, " / висота ", fork_top - fork_base,
         " / паз ", slot_w, " / вісь Ø", hinge_d, " (уздовж X, z=", hinge_z, ")"));
echo(str("Отвір М5: вісь Y=", ear_y, ", z=", ear_z,
         " -> зазор до каналу ", sqrt(ear_y^2 + ear_z^2) - bolt_d / 2 - bore_d / 2,
         " мм (>0 = поза каналом)"));
echo(str("Гайка М5 по вершинах: ", nut_af / cos(30), " мм"));
echo(str("Розріз ", slit_w, " мм у площині x=0"));
echo(str("Габарит X=", 2 * ear_r, " Y=", 2 * (ear_y + ear_r),
         " Z=", -1, "..", fork_top, " мм"));

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build dino.exe",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}

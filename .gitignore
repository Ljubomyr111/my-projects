# ============================================================
#  Секрети — НІКОЛИ не потрапляють у репозиторій
# ============================================================
# tg-bot/config.json містить Telegram bot token і DeepSeek API key.
# Замість нього в репозиторії лежить tg-bot/config.example.json.
tg-bot/config.json
*.secret.json
.env
.env.*

# ============================================================
#  Важкі завантаження, кеші та згенеровані дані
#  (виключено, щоб репозиторій лишався легким; GitHub
#   відхиляє файли понад 100 МБ)
# ============================================================
# У _downloads лежать і гігабайтні архіви, і мої текстові списки
# посилань на моделі — тому виключаю вміст, але повертаю списки.
ai-image/_downloads/*
!ai-image/_downloads/urls.txt
!ai-image/_downloads/urls2.txt
ai-image/_tools/
comfy-data/dl/
comfy-data/pip-cache/
comfy-data/temp/
comfy-data/output/
comfy-data/input/
comfy-data/layers/
pip-cache/

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ============================================================
#  Node.js
# ============================================================
node_modules/
npm-debug.log*
yarn-error.log*

